{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "preserve",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "useDefineForClassFields": true,
    "outDir": "out/tsc-web",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["packages/core/src/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/preload/index.d.ts", "packages/core/src/types.ts"]
}
