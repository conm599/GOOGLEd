{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "noEmit": true,
    "baseUrl": "../..",
    "paths": {
      "@core/*": ["packages/core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "../core/src/**/*.ts"]
}
