{
  "name": "googled",
  "version": "0.1.11",
  "description": "面向中国用户的 Google 云盘桌面客户端，支持断点续传、Cloudflare Workers 反代加速",
  "main": "out/main/index.js",
  "author": "GOOGLEd",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "vue-tsc --noEmit -p tsconfig.web.json && vue-tsc --noEmit -p tsconfig.node.json",
    "dist:win": "npm run build && electron-builder --win --config electron-builder.yml"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "docx-preview": "^0.4.0",
    "element-plus": "^2.8.8",
    "pinia": "^2.2.6",
    "vue": "^3.5.13",
    "vue-router": "^4.4.5",
    "xgplayer": "^3.0.26"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "@vitejs/plugin-vue": "^5.1.4",
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "png-to-ico": "^3.0.2",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vue-tsc": "^2.1.10"
  }
}
