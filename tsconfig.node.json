{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["node"],
    "outDir": "out/tsc-node",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "baseUrl": ".",
    "paths": {
      "@core/*": ["packages/core/src/*"]
    }
  },
  "include": ["src/main/**/*", "src/preload/**/*", "packages/core/src/**/*", "electron.vite.config.ts"]
}
